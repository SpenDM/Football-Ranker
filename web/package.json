{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:rules": "firebase emulators:exec --only firestore --project demo-football-tools --config ../firebase.json \"vitest run --config vitest.rules.config.ts\"",
		"emulators": "firebase emulators:start --only auth,firestore --project demo-football-tools --config ../firebase.json",
		"preview:worker": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy"
	},
	"devDependencies": {
		"@firebase/rules-unit-testing": "^5.0.2",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"firebase-tools": "^15.31.0",
		"jsdom": "^30.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.2",
		"wrangler": "^4.141.0"
	},
	"dependencies": {
		"firebase": "^12.19.0",
		"svelte-dnd-action": "^0.9.79"
	}
}
