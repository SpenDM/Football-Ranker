# Firebase web config (Project settings → General → Your apps). These values are public.
# Leave blank to run without login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Auth/Firestore emulators (`firebase emulators:start`).
VITE_FIREBASE_USE_EMULATORS=false
